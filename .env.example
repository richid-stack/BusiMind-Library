# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Bot token provided by @BotFather for @BusiMind_bot
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_CHANNEL_ID: Private channel ID for legal repository (e.g., -1002345678901)
TELEGRAM_CHANNEL_ID=""

# ADMIN_TELEGRAM_ID: Personal Telegram User ID authorized for /admin catalog commands
ADMIN_TELEGRAM_ID=""

# TELEGRAM_WEBHOOK_SECRET: Secret token for Telegram webhook validation
TELEGRAM_WEBHOOK_SECRET=""

# --- FINANCIAL INTELLIGENCE API KEYS ---
# Twelve Data: Real-time quotes, timeseries, forex (USD/GHS) & global equities
TWELVE_DATA_API_KEY=""

# Alpha Vantage: Institutional financial metrics, cash flows, and global quotes
ALPHA_VANTAGE_API_KEY=""

# Finnhub: Real-time market data, company metrics, analyst ratings & price targets
FINNHUB_API_KEY=""

# Polygon.io (Massive): Institutional US equity snapshot, aggregates & fundamentals
POLYGON_API_KEY=""

# EODHD: Global market data covering 60+ exchanges INCLUDING Ghana Stock Exchange (MTNGH.GSE, GCB.GSE)
EODHD_API_KEY=""

# Financial Modeling Prep (FMP): Automated DCF valuations, Graham numbers, cash flow statements & ratios
FMP_API_KEY=""

WEB_ADMIN_PASSWORD=""

# Groq API Key for open-source model fallbacks (qwen3.8-27b, gpt-oss-120b)
GROQ_API_KEY=""

# Google Books API Key for high-quality book covers
GOOGLE_BOOKS_API_KEY=""
